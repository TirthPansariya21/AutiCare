# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ── Dependencies ─────────────────────────────────────────────────────────
node_modules/

# ── Environment variables (secrets — NEVER commit) ───────────────────────
.env
.env.*
.env*.local

# ── Expo ─────────────────────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# ── Generated native folders ─────────────────────────────────────────────
/ios
/android

# ── Native build artifacts ───────────────────────────────────────────────
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# ── Metro / bundler ──────────────────────────────────────────────────────
.metro-health-check*

# ── Debug logs ───────────────────────────────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*

# ── TypeScript ───────────────────────────────────────────────────────────
*.tsbuildinfo

# ── macOS ────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Windows ──────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Linux ────────────────────────────────────────────────────────────────
*~

# ── IDE / Editor ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── Misc ─────────────────────────────────────────────────────────────────
app-example/
